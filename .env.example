# Which model runs the screening. anthropic | openai | gemini
# Anthropic is the default; the prompts were written and tuned against it.
MODEL_PROVIDER=anthropic
# Optional: override the default model for that provider
# MODEL_NAME=

# Set the key for whichever provider you chose.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: free key from https://developer.company-information.service.gov.uk
# Only needed for `npm run prospects` (building the UK agency prospect list)
COMPANIES_HOUSE_API_KEY=

PORT=3000

# A shared password for the deployed app. Required in production —
# without it a public URL spends your Anthropic key for anyone who finds it.
APP_PASSWORD=
